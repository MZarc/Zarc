<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules for Android 12 and newer.

    Nothing of the vault may leave the device through a backup or a device
    transfer. The vault objects and the wrapped vault master key live in
    `noBackupFilesDir` as well, so this is the second line of defence.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
